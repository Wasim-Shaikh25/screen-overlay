# Copy this file to ".env" and fill in your values.

# Your OpenAI API key (required for cloud reasoning).
OPENAI_API_KEY=sk-your-key-here

# OpenAI model to use for chat/reasoning.
OPENAI_MODEL=gpt-4o-mini

# Whisper model size for local speech-to-text: tiny | base | small | medium | large
WHISPER_MODEL=base

# Edge TTS voice. Run "edge-tts --list-voices" to see all options.
TTS_VOICE=en-US-AriaNeural

# OCR languages (comma-separated easyocr codes), e.g. "en" or "en,es".
OCR_LANGUAGES=en
